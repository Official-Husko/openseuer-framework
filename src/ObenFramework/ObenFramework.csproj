<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ObenFramework</RootNamespace>
    <Description>Framework for Obenseuer mods: game events, player, items, saves, UI and tooling helpers.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ObenLoader/ObenLoader.csproj" />
  </ItemGroup>

  <!-- Loading OGG and MP3 goes through UnityWebRequestMultimedia. The audio and image modules are built against netstandard 2.1. -->
  <ItemGroup>
    <Reference Include="netstandard;UnityEngine.UnityWebRequestModule;UnityEngine.UnityWebRequestAudioModule"
               HintPath="$(ObenManagedDir)/%(Identity).dll" Private="false" />  </ItemGroup>

  <!-- The hook and member checks behind "oben check", run in the game at start (Diagnostics/GameCheck). Cecil
       ships in the game's Managed folder with the loader, so it is only referenced here. -->
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="$(CecilVersion)" IncludeAssets="compile" PrivateAssets="all" />
    <Compile Include="../Shared/GameCheck/*.cs" Link="Diagnostics/Checks/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Bug reports (Diagnostics/Reports): the parts without Unity are shared with the oben tool and the tests. The game
       ships System.IO.Compression.dll in its Managed folder; the zip writer needs it. -->
  <ItemGroup>
    <Compile Include="../Shared/Reports/*.cs" Link="Diagnostics/Reports/Shared/%(Filename)%(Extension)" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <!-- Ships as a regular mod folder: <game>/Mods/ObenFramework. -->
  <Import Project="$(RepoRoot)build/Mod.targets" />
</Project>
