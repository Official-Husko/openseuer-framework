<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ObenUIKit</RootNamespace>
    <Description>UI toolkit for Obenseuer mods, built from the game's own UI elements, and the mod menu.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ObenLoader/ObenLoader.csproj" />
    <ProjectReference Include="../ObenFramework/ObenFramework.csproj" />
  </ItemGroup>

  <!-- The release changelog (written by "oben changelog" with the write option) ships with the kit; the What's New page reads it from the kit's folder. -->
  <ItemGroup>
    <None Include="$(RepoRoot)changelog.json" Link="changelog.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(RepoRoot)changelog.json')" />
  </ItemGroup>

  <!-- Ships as a regular mod folder: <game>/Mods/ObenUIKit. -->
  <Import Project="$(RepoRoot)build/Mod.targets" />
</Project>
