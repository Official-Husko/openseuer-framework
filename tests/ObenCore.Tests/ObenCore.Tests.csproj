    <Compile Include="../../tools/ObenTool/Cli/Args.cs" Link="Linked/Args.cs" />
    <Compile Include="../../tools/ObenTool/Cli/JsonOut.cs" Link="Linked/JsonOut.cs" />
    <Compile Include="../../tools/ObenTool/Bridge/BridgeClient.cs" Link="Linked/BridgeClient.cs" />
    <Compile Include="../../tools/ObenTool/Scripting/ScriptSource.cs" Link="Linked/ScriptSource.cs" />
    <Compile Include="../../tools/ObenTool/Checks/*.cs" LinkBase="Linked/Checks" />
  </ItemGroup>
</Project>
